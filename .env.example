# Copy to .env (ignored by Git) and fill in. Never commit a real key.
# Decision provider: claude (default) or openai
DECISIONS_PROVIDER=claude
ANTHROPIC_API_KEY=
# Only needed with DECISIONS_PROVIDER=openai
OPENAI_API_KEY=
# Optional
# DECISIONS_MODEL=gpt-6-luna        (OpenAI default; Claude default is claude-opus-5-5)
# DECISIONS_TIMEOUT_S=20
# PAPER_ORDER_SIZE=1
